{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "strict": true,
    "experimentalDecorators": true,
    "noEmitHelpers": true,
    "noEmitOnError": true,
    "removeComments": true,
    "sourceMap": false,
    "lib": ["ES2020"],
    "types": ["@cocos/creator-types"]
  },
  "include": ["assets/**/*.ts"],
  "exclude": ["node_modules"]
}
